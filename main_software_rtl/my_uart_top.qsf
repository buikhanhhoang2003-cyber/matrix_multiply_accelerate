# Project sources and timing; hardware pins come from the full board QSF.
# Keep top-level port names aligned with cyclone_iv_board_v3.qsf.
# USB-to-TTL UART uses uart_tx (PIN_114) and gpio (PIN_111) for reception.
source cyclone_iv_board_v3.qsf

set_global_assignment -name TOP_LEVEL_ENTITY my_uart_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE my_uart_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE my_uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE my_uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE speed_select.sv
set_global_assignment -name SYSTEMVERILOG_FILE matrix_multiply.sv
set_global_assignment -name SDC_FILE my_uart_top.sdc
