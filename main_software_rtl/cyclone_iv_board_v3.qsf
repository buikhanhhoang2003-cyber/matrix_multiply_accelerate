# Altera Cyclone IV development board V3.0 -- board pin assignments
# FPGA: EP4CE6E22C8, 144-pin EQFP. All FPGA I/O banks use 3.3 V.
#
# Sources in this repository:
#   Hardware documentation/Development board pin information.pdf (pages 1-3)
#   Hardware documentation/Development board schematic diagram V2.1.pdf
#   Example code/Peripheral control 01 through 16 (matching EP4CE6 projects)
# The supplied schematic is V2.1; verify the fitted FPGA and PCB revision.
#
# Usage:
#   Import this file using Quartus Assignments > Import Assignments, or copy
#   it beside your project's QSF and add: source cyclone_iv_board_v3.qsf
#   Keep only the module sections used by your design. Top-level HDL port
#   names and vector indices must match the names below, or be renamed here.
#   Set your own TOP_LEVEL_ENTITY, HDL source files and SDC_FILE in the project.
#   This file assigns pins; it does not create ports, drivers or timing rules.
#   In your SDC, constrain the oscillator with:
#     create_clock -name clk_50mhz -period 20.000 [get_ports {clk_50mhz}]
#
# Directions below are relative to the FPGA. Suffix _n means active low.
# Do not assign separate HDL ports to a shared physical pin.

# ---------------------------------------------------------------------------
# FPGA device and unused pins
# ---------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
# The board manual requires unused pins to be inputs in high impedance.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
# Release dual-purpose pins used by VGA, EEPROM and LEDs.
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name ENABLE_INIT_DONE_OUTPUT OFF
set_global_assignment -name ENABLE_DEVICE_WIDE_RESET OFF
set_global_assignment -name ENABLE_DEVICE_WIDE_OE OFF

# ---------------------------------------------------------------------------
# 50 MHz oscillator and reset button -- inputs
# RESET has a 10 kohm pull-up; pressing the button pulls it low.
# ---------------------------------------------------------------------------
set_location_assignment PIN_23 -to clk_50mhz
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50mhz
set_location_assignment PIN_25 -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n

# ---------------------------------------------------------------------------
# Pushbuttons / DIP switches -- inputs, active low
# key_n[0..3] = KEY1..KEY4 = DIP switch positions 1..4.
# Each button and corresponding DIP switch share a pin: either can pull it low.
# Leave a DIP position OFF when using its corresponding button.
# ---------------------------------------------------------------------------
set_location_assignment PIN_88 -to {key_n[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {key_n[0]}
set_location_assignment PIN_89 -to {key_n[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {key_n[1]}
set_location_assignment PIN_90 -to {key_n[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {key_n[2]}
set_location_assignment PIN_91 -to {key_n[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {key_n[3]}

# ---------------------------------------------------------------------------
# Four user LEDs -- outputs, 0 = on, 1 = off
# led_n[0..3] follows LED1..LED4 in the pin table and vendor LED examples.
# The V2.1 schematic's LED net labels use the reverse order (84..87).
# ---------------------------------------------------------------------------
set_location_assignment PIN_87 -to {led_n[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {led_n[0]}
set_location_assignment PIN_86 -to {led_n[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {led_n[1]}
set_location_assignment PIN_85 -to {led_n[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {led_n[2]}
set_location_assignment PIN_84 -to {led_n[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {led_n[3]}

# ---------------------------------------------------------------------------
# Four-digit, common-anode seven-segment display -- outputs, active low
# digit_n[0..3] = DIG1..DIG4; 0 enables a digit through its PNP transistor.
# seg_n[0..7] = a, b, c, d, e, f, g, decimal point; 0 lights a segment.
# ---------------------------------------------------------------------------
set_location_assignment PIN_133 -to {digit_n[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {digit_n[0]}
set_location_assignment PIN_135 -to {digit_n[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {digit_n[1]}
set_location_assignment PIN_136 -to {digit_n[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {digit_n[2]}
set_location_assignment PIN_137 -to {digit_n[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {digit_n[3]}
set_location_assignment PIN_128 -to {seg_n[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[0]}
set_location_assignment PIN_121 -to {seg_n[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[1]}
set_location_assignment PIN_125 -to {seg_n[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[2]}
set_location_assignment PIN_129 -to {seg_n[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[3]}
set_location_assignment PIN_132 -to {seg_n[4]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[4]}
set_location_assignment PIN_126 -to {seg_n[5]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[5]}
set_location_assignment PIN_124 -to {seg_n[6]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[6]}
set_location_assignment PIN_127 -to {seg_n[7]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {seg_n[7]}

# ---------------------------------------------------------------------------
# Buzzer / speaker -- output, active-low PNP driver
# Drive a waveform to make a tone; hold buzzer_n high when idle.
# ---------------------------------------------------------------------------
set_location_assignment PIN_110 -to buzzer_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to buzzer_n

# ---------------------------------------------------------------------------
# RS-232 UART through onboard MAX3232 -- TX output, RX input
# These are the FPGA-side logic signals, not RS-232 voltage levels.
# ---------------------------------------------------------------------------
set_location_assignment PIN_114 -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx
set_location_assignment PIN_115 -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx

# ---------------------------------------------------------------------------
# AT24C08 EEPROM I2C bus -- open-drain signals, external 3.3 V pull-ups
# Board nets I2C_SCL / I2C_SDA. Drive 0 or Z in HDL, never push-pull high.
# SDA is bidirectional; release SCL too if supporting clock stretching.
# Keep INIT_DONE and CRC_ERROR outputs disabled on these dual-purpose pins.
# ---------------------------------------------------------------------------
set_location_assignment PIN_99 -to eeprom_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to eeprom_scl
set_location_assignment PIN_98 -to eeprom_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to eeprom_sda

# ---------------------------------------------------------------------------
# LM75 / LM75A temperature sensor I2C bus -- separate from the EEPROM bus
# Board nets SCL / SDA, with external 3.3 V pull-ups. Drive only 0 or Z.
# SDA is bidirectional; release SCL too if supporting clock stretching.
# ---------------------------------------------------------------------------
set_location_assignment PIN_112 -to temp_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to temp_scl
set_location_assignment PIN_113 -to temp_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to temp_sda

# ---------------------------------------------------------------------------
# PS/2 keyboard / mouse -- bidirectional, open drain (drive 0 or Z)
# The V2.1 schematic shows 5 V pull-ups R23/R24 and 470 ohm series resistors.
# Verify safe input voltage / level shifting on your PCB before using PS/2;
# a 3.3-V LVTTL assignment does not provide 5 V tolerance.
# ---------------------------------------------------------------------------
set_location_assignment PIN_119 -to ps2_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ps2_clk
set_location_assignment PIN_120 -to ps2_data
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ps2_data

# ---------------------------------------------------------------------------
# Infrared receiver -- input
# ---------------------------------------------------------------------------
set_location_assignment PIN_100 -to ir_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ir_rx

# ---------------------------------------------------------------------------
# Onboard VGA connector -- outputs, one bit per color (8 colors)
# This is not the optional 16-bit VGA expansion module used by the camera demo.
# PIN_101 is also nCEO; the device setting above releases it for VGA HSYNC.
# ---------------------------------------------------------------------------
set_location_assignment PIN_101 -to vga_hsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_hsync
set_location_assignment PIN_103 -to vga_vsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_vsync
set_location_assignment PIN_106 -to vga_r
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_r
set_location_assignment PIN_105 -to vga_g
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_g
set_location_assignment PIN_104 -to vga_b
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_b

# ---------------------------------------------------------------------------
# LCD1602 / LCD12864 parallel connector -- one shared interface
# lcd_rs, lcd_rw, lcd_en are outputs; lcd_data[7:0] is bidirectional for reads.
# RS/RW/E are board nets LCD1/LCD2/LCD3; data[0..7] = LCD4..LCD11.
# The connector supplies 5 V: check LCD data output levels before reading.
# For write-only operation, hold lcd_rw low and drive lcd_data as outputs.
# ---------------------------------------------------------------------------
set_location_assignment PIN_141 -to lcd_rs
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_rs
set_location_assignment PIN_138 -to lcd_rw
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_rw
set_location_assignment PIN_143 -to lcd_en
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_en
set_location_assignment PIN_142 -to {lcd_data[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[0]}
set_location_assignment PIN_1 -to {lcd_data[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[1]}
set_location_assignment PIN_144 -to {lcd_data[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[2]}
set_location_assignment PIN_3 -to {lcd_data[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[3]}
set_location_assignment PIN_2 -to {lcd_data[4]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[4]}
set_location_assignment PIN_10 -to {lcd_data[5]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[5]}
set_location_assignment PIN_7 -to {lcd_data[6]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[6]}
set_location_assignment PIN_11 -to {lcd_data[7]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {lcd_data[7]}

# ---------------------------------------------------------------------------
# 64-Mbit (8 MiB), x16 SDR SDRAM -- HY57V641620 or compatible fitted part
# Address[11:0], bank[1:0], clock and command signals are outputs.
# Data[15:0] is bidirectional. DQM[0] masks DQ[7:0], DQM[1] masks DQ[15:8].
# Command signals ending _n are active low; CKE and DQM are active high.
# Constrain the SDRAM interface and any PLL clocks separately in your SDC.
# ---------------------------------------------------------------------------
set_location_assignment PIN_43 -to sdram_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_clk
set_location_assignment PIN_58 -to sdram_cke
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cke
set_location_assignment PIN_72 -to sdram_cs_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cs_n
set_location_assignment PIN_71 -to sdram_ras_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_ras_n
set_location_assignment PIN_70 -to sdram_cas_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cas_n
set_location_assignment PIN_69 -to sdram_we_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_we_n
set_location_assignment PIN_73 -to {sdram_ba[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_ba[0]}
set_location_assignment PIN_74 -to {sdram_ba[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_ba[1]}
set_location_assignment PIN_42 -to {sdram_dqm[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dqm[0]}
set_location_assignment PIN_55 -to {sdram_dqm[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dqm[1]}
set_location_assignment PIN_76 -to {sdram_addr[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[0]}
set_location_assignment PIN_77 -to {sdram_addr[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[1]}
set_location_assignment PIN_80 -to {sdram_addr[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[2]}
set_location_assignment PIN_83 -to {sdram_addr[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[3]}
set_location_assignment PIN_68 -to {sdram_addr[4]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[4]}
set_location_assignment PIN_67 -to {sdram_addr[5]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[5]}
set_location_assignment PIN_66 -to {sdram_addr[6]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[6]}
set_location_assignment PIN_65 -to {sdram_addr[7]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[7]}
set_location_assignment PIN_64 -to {sdram_addr[8]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[8]}
set_location_assignment PIN_60 -to {sdram_addr[9]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[9]}
set_location_assignment PIN_75 -to {sdram_addr[10]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[10]}
set_location_assignment PIN_59 -to {sdram_addr[11]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_addr[11]}
set_location_assignment PIN_28 -to {sdram_dq[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[0]}
set_location_assignment PIN_30 -to {sdram_dq[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[1]}
set_location_assignment PIN_31 -to {sdram_dq[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[2]}
set_location_assignment PIN_32 -to {sdram_dq[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[3]}
set_location_assignment PIN_33 -to {sdram_dq[4]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[4]}
set_location_assignment PIN_34 -to {sdram_dq[5]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[5]}
set_location_assignment PIN_38 -to {sdram_dq[6]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[6]}
set_location_assignment PIN_39 -to {sdram_dq[7]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[7]}
set_location_assignment PIN_54 -to {sdram_dq[8]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[8]}
set_location_assignment PIN_53 -to {sdram_dq[9]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[9]}
set_location_assignment PIN_52 -to {sdram_dq[10]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[10]}
set_location_assignment PIN_51 -to {sdram_dq[11]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[11]}
set_location_assignment PIN_50 -to {sdram_dq[12]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[12]}
set_location_assignment PIN_49 -to {sdram_dq[13]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[13]}
set_location_assignment PIN_46 -to {sdram_dq[14]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[14]}
set_location_assignment PIN_44 -to {sdram_dq[15]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {sdram_dq[15]}

# ---------------------------------------------------------------------------
# Expansion headers -- two additional signals on P1
# ext_clk_in is an input on CLK2 (P1 contact 34); gpio is on P1 contact 4.
# P1's other signals mirror the buzzer, temperature I2C, UART, PS/2, display
# and LCD pins above. P2 mirrors the SDRAM pins; P3 mirrors keys, LEDs,
# EEPROM I2C, IR and onboard VGA. These are shared nets, not extra I/O.
# The headers also expose power/GND contacts; those are not FPGA signals.
# ---------------------------------------------------------------------------
set_location_assignment PIN_24 -to ext_clk_in
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ext_clk_in
set_location_assignment PIN_111 -to gpio
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio

# ---------------------------------------------------------------------------
# Dedicated programming interfaces -- no user-port assignments
# JTAG: TDI=15, TCK=16, TMS=18, TDO=20.
# EPCS configuration flash: ASDO=6, nCSO=8, DCLK=12, DATA0=13.
# Leave these under Quartus configuration control for normal programming.
# Optional TFT, SD-card, OV7670 and 16-bit VGA modules require their own
# wiring-specific assignments and removal of conflicting onboard assignments.
# ---------------------------------------------------------------------------

